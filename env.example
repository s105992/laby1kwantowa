# Linux: sprawdź poleceniami: id -u oraz id -g
UID=1000
GID=1000

# Port lokalnego JupyterLab
JUPYTER_PORT=8888

# Zmień przed przekazaniem środowiska użytkownikom.
JUPYTER_TOKEN=qiskit-local

# IBM Quantum Platform — pozostaw puste, jeśli nie jest używane.
# Nie zapisuj prawdziwego tokenu w repozytorium.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
